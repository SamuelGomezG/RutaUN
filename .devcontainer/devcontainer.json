{
  "name": "RutaUN (Java 21)",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack"
      ]
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "chmod +x mvnw && ./mvnw -q -DskipTests dependency:go-offline"
}