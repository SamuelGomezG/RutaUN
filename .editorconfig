root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 2

[*.md]
# Una línea final sin salto deja el archivo incompleto, pero los espacios al
# final de la línea son el salto duro de Markdown.
trim_trailing_whitespace = false
